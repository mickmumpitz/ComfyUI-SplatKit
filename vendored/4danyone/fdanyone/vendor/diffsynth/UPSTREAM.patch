+def pad_for_3d_conv(x, kernel_size):
+    """Pad to be divisible by kernel_size. From FramePack."""
+    _, _, t, h, w = x.shape
+    pt, ph, pw = kernel_size
+    pad_t = (pt - (t % pt)) % pt
+    pad_h = (ph - (h % ph)) % ph
+    pad_w = (pw - (w % pw)) % pw
+    if pad_t == 0 and pad_h == 0 and pad_w == 0:
+        return x
+    return F.pad(x, (0, pad_w, 0, pad_h, 0, pad_t), mode='replicate')
